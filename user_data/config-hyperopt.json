{
  // ~~ Paths and Logging ~~
  "bot_name": "PC-Hyperopt",
  "user_data_dir": "user_data",
  "logfile": "user_data/logs/hyperopt/freqtrade_hyperopt.log",
  "add_config_files": [
    "pair_list/test/hyperopt_list.json",
    "pair_list/private/config-private.json"
  ],
  "db_url": "sqlite:///user_data/sqlite/hyperopt-trades_v3.sqlite",
  // ~~ Strategy ~~
  "strategy": "",
  "strategy_path": "user_data/strategies/",
  "recursive_strategy_search": false,
  // ~~ Bot Parameters ~~
  "max_open_trades": 5,
  "force_entry_enable": false,
  "cancel_open_orders_on_exit": false,
  // ~~ Wallet Managment parameters ~~
  "stake_currency": "USDT",
  "trading_mode": "spot",
  //"margin_mode": "",
  // ~~ Dry-run ~~
  "dry_run": true,
  "dry_run_wallet": 100,
  // ~~ Live Run ~~
  "tradable_balance_ratio": 0.95,
  //"available_capital": 100,
  "stake_amount": 10,
  "amount_reserve_percent": 0.05,
  // ~~ Custom Price Safety ~~
  "custom_price_max_distance_ratio": 0.02,
  // ~~ Last Stake Amount Funtion ~~
  "amend_last_stake_amount": true,
  "last_stake_amount_min_ratio": 0.5,
  // ~~ Timeout ~~
  "ignore_buying_expired_candle_after": 120,
  "disable_dataframe_checks": false,
  // ~~ Buying ~~
  "entry_pricing": {
    "price_side": "other",
    "use_order_book": false,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  // ~~ Selling ~~
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": false,
    "order_book_top": 1,
    "price_last_balance": 0.0
  },
  // ~~ Freqtrade UI Server ~~
  "api_server": {
    "enabled": false,
    "listen_ip_address": "127.0.0.1",
    "listen_port": 8081,
    "verbosity": "error",
    "enable_openapi": false,
    "CORS_origins": ["http://127.0.0.1:8081"]
  },
  // ~~ Data Type ~~
  "dataformat_ohlcv": "feather",
  "dataformat_trades": "feather",
  // ~~ Data / RAM ~~
  "reduce_df_footprint": false,
  // ~~ State and Clocks ~~
  "initial_state": "running",
  "internals": {
    "process_throttle_secs": 5,
    "heartbeat_interval": 60,
    "sd_notify": false
  },
  // ~~ Experimental ~~
  "experimental": {
    "block_bad_exchanges": true
  }
